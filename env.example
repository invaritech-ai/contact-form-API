# Google Apps Script Web App URL
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SCRIPT_WEBHOOK_SECRET=your-long-random-webhook-secret

# reCAPTCHA Secret Key for server-side validation (optional but recommended for security)
# Get this from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# OpenRouter API key for /api/assessment AI insights (optional)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional model override for /api/assessment
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter attribution headers
OPENROUTER_REFERER=https://your-site.example
OPENROUTER_APP_NAME=Invaritech Assessment API
