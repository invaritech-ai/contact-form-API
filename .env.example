# ---------------------------------------------------------------------------
# Invaritech Contact API — Cloudflare Worker
#
# Local development: copy to .env.local and fill in. `wrangler dev` loads that
# file automatically and exposes each key on the Worker's `env` object.
#
# Production: the five secrets below are set with `wrangler secret put NAME`.
# The non-secret values live in [vars] in wrangler.toml, not here.
# ---------------------------------------------------------------------------

# --- Secrets (wrangler secret put) -----------------------------------------

# Cloudflare Turnstile secret key (Dashboard > Turnstile > your widget).
# Pairs with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the website.
# Unset means every submission is refused with 503.
TURNSTILE_SECRET_KEY=

# Google service account with Editor access to the leads spreadsheet.
# Share the spreadsheet with this address.
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com

# The full PEM private key on one line. Literal \n sequences are expanded
# before the key is imported.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
LEADS_SPREADSHEET_ID=

# Resend API key (resend.com > API Keys). Needs sending permission only.
RESEND_API_KEY=

# --- Non-secret configuration ----------------------------------------------
# Production values come from [vars] in wrangler.toml. Set them here only to
# override during local development.

# Sender address. Its domain must be verified in Resend or delivery fails.
CONTACT_NOTIFICATION_FROM="Invaritech Website <website@invaritech.ai>"

# Where notifications are delivered. Comma-separated for multiple recipients.
CONTACT_NOTIFICATION_TO=hello@invaritech.ai

# Browser origins allowed to call this API, comma-separated, exact match,
# no trailing slash. Requests without an Origin header (curl) are not blocked.
ALLOWED_ORIGINS=https://invaritech.ai,https://www.invaritech.ai

# Tab name within the spreadsheet. Defaults to Sheet1.
LEADS_SHEET_NAME=Sheet1

# Maximum accepted request body in bytes. Defaults to 100000.
MAX_BODY_BYTES=100000

# Rate limiting is configured by the [[ratelimits]] binding in wrangler.toml,
# not by an environment variable.
