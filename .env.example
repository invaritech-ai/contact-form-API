# ---------------------------------------------------------------------------
# Invaritech Contact API — environment variables
# Copy to .env.local for local development; set the same keys in your host's
# secret store for production. Never commit real values.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile secret key (Dashboard > Turnstile > your widget).
# Pairs with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the website.
# Required. Submissions are rejected when this is unset.
TURNSTILE_SECRET_KEY=

# Google service-account credentials with access to the leads spreadsheet.
# Share the spreadsheet with GOOGLE_SHEETS_CLIENT_EMAIL as an Editor.
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com

# The full PEM private key. Keep the literal \n sequences on one line when the
# host does not accept multi-line values; they are expanded at runtime.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
LEADS_SPREADSHEET_ID=

# Optional. Tab name within that spreadsheet. Defaults to Sheet1.
LEADS_SHEET_NAME=Sheet1

# Resend API key (resend.com > API Keys). Needs sending permission only.
RESEND_API_KEY=

# Sender address. Its domain must be verified in Resend or delivery fails.
CONTACT_NOTIFICATION_FROM="Invaritech Website <website@invaritech.ai>"

# Where notifications are delivered. Comma-separated for multiple recipients.
CONTACT_NOTIFICATION_TO=hello@invaritech.ai

# Browser origins allowed to call this API, comma-separated, exact match,
# no trailing slash. Requests without an Origin header (curl) are not blocked.
ALLOWED_ORIGINS=https://invaritech.ai,https://www.invaritech.ai

# Optional. Best-effort per-instance rate limit. Defaults: 5 requests / 60s.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Optional. Maximum accepted request body in bytes. Defaults to 100000.
MAX_BODY_BYTES=100000
